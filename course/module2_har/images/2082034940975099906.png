<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 400" font-family="Segoe UI, Microsoft YaHei, sans-serif">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#2563eb"/><stop offset="100%" stop-color="#1d4ed8"/></linearGradient>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#0d9488"/><stop offset="100%" stop-color="#0f766e"/></linearGradient>
  </defs>

  <text x="360" y="28" text-anchor="middle" font-size="18" font-weight="bold" fill="#111">HAR 行为识别服务 — RESTful API 架构</text>

  <!-- Client -->
  <rect x="40" y="50" width="120" height="36" rx="6" fill="url(#bg1)"/>
  <text x="100" y="73" text-anchor="middle" font-size="13" fill="#fff" font-weight="bold">Web 前端</text>

  <rect x="40" y="100" width="120" height="36" rx="6" fill="url(#bg1)"/>
  <text x="100" y="123" text-anchor="middle" font-size="13" fill="#fff" font-weight="bold">外部客户端</text>

  <!-- Arrows from client to API -->
  <line x1="160" y1="68" x2="230" y2="68" stroke="#666" stroke-width="1.5" stroke-dasharray="6,3"/>
  <line x1="160" y1="118" x2="230" y2="118" stroke="#666" stroke-width="1.5" stroke-dasharray="6,3"/>
  <text x="195" y="60" text-anchor="middle" font-size="10" fill="#666">HTTP</text>
  <text x="195" y="108" text-anchor="middle" font-size="10" fill="#666">HTTP</text>

  <!-- API Server -->
  <rect x="235" y="46" width="250" height="124" rx="10" fill="#f0f9ff" stroke="#2563eb" stroke-width="2"/>
  <text x="360" y="68" text-anchor="middle" font-size="14" fill="#1e40af" font-weight="bold">FastAPI 服务器</text>
  <text x="360" y="84" text-anchor="middle" font-size="11" fill="#3b82f6">http://localhost:8082</text>
  <line x1="250" y1="94" x2="470" y2="94" stroke="#bfdbfe" stroke-width="1"/>
  <text x="360" y="112" text-anchor="middle" font-size="11" fill="#1e40af">GET / POST / DELETE</text>
  <text x="360" y="128" text-anchor="middle" font-size="11" fill="#1e40af">JSON 请求/响应</text>
  <text x="360" y="144" text-anchor="middle" font-size="11" fill="#1e40af">自动生成 Swagger UI 文档</text>
  <text x="360" y="160" text-anchor="middle" font-size="11" fill="#1e40af">异步任务管理 (线程池)</text>

  <!-- Arrow API to Backend -->
  <line x1="485" y1="108" x2="550" y2="108" stroke="#666" stroke-width="1.5"/>
  <text x="518" y="100" text-anchor="middle" font-size="10" fill="#666">调用</text>

  <!-- Backend Core -->
  <rect x="555" y="46" width="156" height="124" rx="10" fill="#f0fdf4" stroke="#059669" stroke-width="2"/>
  <text x="633" y="68" text-anchor="middle" font-size="14" fill="#065f46" font-weight="bold">推理引擎</text>
  <line x1="570" y1="78" x2="696" y2="78" stroke="#a7f3d0" stroke-width="1"/>
  <text x="633" y="96" text-anchor="middle" font-size="11" fill="#065f46">YOLOv8 检测</text>
  <text x="633" y="112" text-anchor="middle" font-size="11" fill="#065f46">ByteTrack 跟踪</text>
  <text x="633" y="128" text-anchor="middle" font-size="11" fill="#065f46">YOLO-Pose 姿态</text>
  <text x="633" y="144" text-anchor="middle" font-size="11" fill="#065f46">规则引擎</text>
  <text x="633" y="160" text-anchor="middle" font-size="11" fill="#065f46">MMAction2 TSN</text>

  <!-- Lower section - Endpoints -->
  <text x="360" y="200" text-anchor="middle" font-size="15" font-weight="bold" fill="#111">主要 API 端点</text>

  <rect x="30" y="215" width="320" height="30" rx="4" fill="#e8f5e9"/>
  <text x="50" y="235" font-size="11" fill="#2e7d32" font-family="monospace">GET /api/v1/health</text>
  <text x="280" y="235" text-anchor="end" font-size="10" fill="#666">健康检查</text>

  <rect x="30" y="250" width="320" height="30" rx="4" fill="#e3f2fd"/>
  <text x="50" y="270" font-size="11" fill="#1565c0" font-family="monospace">GET /api/v1/demo-samples</text>
  <text x="280" y="270" text-anchor="end" font-size="10" fill="#666">Demo 列表</text>

  <rect x="30" y="285" width="320" height="30" rx="4" fill="#fff3e0"/>
  <text x="50" y="305" font-size="11" fill="#e65100" font-family="monospace">POST /api/v1/behavior/analyze</text>
  <text x="280" y="305" text-anchor="end" font-size="10" fill="#666">上传分析 (核心)</text>

  <rect x="30" y="320" width="320" height="30" rx="4" fill="#e3f2fd"/>
  <text x="50" y="340" font-size="11" fill="#1565c0" font-family="monospace">GET /api/v1/jobs/{id}</text>
  <text x="280" y="340" text-anchor="end" font-size="10" fill="#666">任务查询</text>

  <rect x="30" y="355" width="320" height="30" rx="4" fill="#e3f2fd"/>
  <text x="50" y="375" font-size="11" fill="#1565c0" font-family="monospace">GET /api/v1/media/{id}/annotated</text>
  <text x="280" y="375" text-anchor="end" font-size="10" fill="#666">标注媒体</text>

  <!-- Methods legend -->
  <rect x="390" y="215" width="310" height="120" rx="8" fill="#fafafa" stroke="#e5e5e5" stroke-width="1"/>
  <text x="420" y="238" font-size="12" fill="#333" font-weight="bold">HTTP 方法</text>
  <circle cx="420" cy="258" r="5" fill="#2e7d32"/>
  <text x="435" y="262" font-size="11" fill="#333">GET — 获取资源</text>
  <circle cx="420" cy="280" r="5" fill="#e65100"/>
  <text x="435" y="284" font-size="11" fill="#333">POST — 创建/执行</text>
  <circle cx="420" cy="302" r="5" fill="#d32f2f"/>
  <text x="435" y="306" font-size="11" fill="#333">DELETE — 删除资源</text>

  <text x="430" y="330" font-size="11" fill="#666">状态码：200 | 400 | 404 | 413 | 422 | 500</text>

  <!-- Bottom line -->
  <rect x="100" y="380" width="520" height="1" fill="#e5e5e5"/>
</svg>
