<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4A90D9"/>
    </marker>
    <marker id="arrowRed" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#E74C3C"/>
    </marker>
    <marker id="arrowBlue" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#3498DB"/>
    </marker>
  </defs>

  <!-- 标题 -->
  <text x="400" y="28" text-anchor="middle" fill="#333" font-size="18" font-weight="bold">LangGraph StateGraph 架构</text>

  <!-- START -->
  <rect x="360" y="50" width="80" height="30" rx="15" fill="#555"/>
  <text x="400" y="70" text-anchor="middle" fill="white" font-size="12" font-weight="bold">START</text>

  <line x1="400" y1="80" x2="400" y2="105" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- perceive -->
  <rect x="280" y="110" width="240" height="60" rx="10" fill="#2ECC71"/>
  <text x="400" y="135" text-anchor="middle" fill="white" font-size="14" font-weight="bold">🔍 perceive</text>
  <text x="400" y="155" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="11">感知：读取传感器 / 获取数据</text>

  <line x1="400" y1="170" x2="400" y2="195" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- decide -->
  <rect x="280" y="200" width="240" height="60" rx="10" fill="#F39C12"/>
  <text x="400" y="225" text-anchor="middle" fill="white" font-size="14" font-weight="bold">🧠 decide</text>
  <text x="400" y="245" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="11">决策：分析状态 · 确定下一步</text>

  <line x1="400" y1="260" x2="400" y2="285" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- act -->
  <rect x="280" y="290" width="240" height="60" rx="10" fill="#E74C3C"/>
  <text x="400" y="315" text-anchor="middle" fill="white" font-size="14" font-weight="bold">⚡ act</text>
  <text x="400" y="335" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="11">行动：执行指令 · 发布命令</text>

  <!-- 从 act 到 条件判断 -->
  <line x1="400" y1="350" x2="400" y2="380" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 条件判断 -->
  <polygon points="400,385 440,410 400,435 360,410" fill="#3498DB"/>
  <text x="400" y="413" text-anchor="middle" fill="white" font-size="11" font-weight="bold">条件</text>

  <!-- 循环回路 -->
  <path d="M 360 410 L 120 410 L 120 140 L 275 140" fill="none" stroke="#3498DB" stroke-width="2" stroke-dasharray="6,4" marker-end="url(#arrowBlue)"/>
  <rect x="130" y="260" width="110" height="24" rx="12" fill="rgba(52,152,219,0.1)"/>
  <text x="185" y="276" text-anchor="middle" fill="#3498DB" font-size="10" font-weight="bold">continue 循环</text>

  <!-- 结束分支 -->
  <path d="M 440 410 L 560 410 L 560 450" fill="none" stroke="#E74C3C" stroke-width="2" stroke-dasharray="6,4" marker-end="url(#arrowRed)"/>
  <rect x="520" y="395" width="80" height="22" rx="11" fill="rgba(231,76,60,0.1)"/>
  <text x="560" y="410" text-anchor="middle" fill="#E74C3C" font-size="10" font-weight="bold">end 结束</text>

  <!-- END -->
  <rect x="520" y="455" width="80" height="30" rx="15" fill="#555"/>
  <text x="560" y="475" text-anchor="middle" fill="white" font-size="12" font-weight="bold">END</text>

  <!-- 右侧 State 说明 -->
  <rect x="560" y="110" width="220" height="200" rx="10" fill="#2C3E50"/>
  <text x="670" y="138" text-anchor="middle" fill="#ECF0F1" font-size="13" font-weight="bold">State (TypedDict)</text>
  <line x1="580" y1="148" x2="760" y2="148" stroke="#7F8C8D" stroke-width="1"/>

  <text x="580" y="170" fill="#BDC3C7" font-size="10">class AgentState(TypedDict):</text>
  <text x="585" y="188" fill="#E74C3C" font-size="9">sensor_data</text><text x="668" y="188" fill="#7F8C8D" font-size="9"># 传感器数据</text>
  <text x="585" y="203" fill="#3498DB" font-size="9">decision</text><text x="655" y="203" fill="#7F8C8D" font-size="9"># 决策结果</text>
  <text x="585" y="218" fill="#2ECC71" font-size="9">should_continue</text><text x="705" y="218" fill="#7F8C8D" font-size="9"># 是否循环</text>
  <text x="585" y="233" fill="#F39C12" font-size="9">result</text><text x="637" y="233" fill="#7F8C8D" font-size="9"># 最终结果</text>
  <text x="585" y="248" fill="#9B59B6" font-size="9">log</text><text x="617" y="248" fill="#7F8C8D" font-size="9"># Annotated 追加日志</text>
  <line x1="580" y1="258" x2="760" y2="258" stroke="#7F8C8D" stroke-width="1"/>
  <text x="585" y="275" fill="#BDC3C7" font-size="9">节点间传递和累加更新</text>
  <text x="585" y="293" fill="#BDC3C7" font-size="9">Checkpoint 自动保存快照</text>

  <!-- 下方关键概念 -->
  <rect x="55" y="70" width="195" height="340" rx="10" fill="#F8F9FA" stroke="#DEE2E6"/>
  <text x="152" y="95" text-anchor="middle" fill="#333" font-size="12" font-weight="bold">核心概念</text>
  <line x1="70" y1="105" x2="235" y2="105" stroke="#DEE2E6" stroke-width="1"/>

  <circle cx="95" cy="130" r="6" fill="#2ECC71"/>
  <text x="110" y="135" fill="#555" font-size="11" font-weight="bold">Node (节点)</text>
  <text x="115" y="152" fill="#777" font-size="9">纯函数 (state)→update_dict</text>

  <circle cx="95" cy="175" r="6" fill="#4A90D9"/>
  <text x="110" y="180" fill="#555" font-size="11" font-weight="bold">Edge (普通边)</text>
  <text x="115" y="197" fill="#777" font-size="9">固定跳转 A→B</text>

  <circle cx="95" cy="220" r="6" fill="#E74C3C"/>
  <text x="110" y="225" fill="#555" font-size="11" font-weight="bold">Conditional Edge</text>
  <text x="115" y="242" fill="#777" font-size="9">根据状态动态路由</text>

  <circle cx="95" cy="265" r="6" fill="#F39C12"/>
  <text x="110" y="270" fill="#555" font-size="11" font-weight="bold">Graph</text>
  <text x="115" y="287" fill="#777" font-size="9">所有节点+边的有向图</text>

  <circle cx="95" cy="310" r="6" fill="#9B59B6"/>
  <text x="110" y="315" fill="#555" font-size="11" font-weight="bold">Compile</text>
  <text x="115" y="332" fill="#777" font-size="9">编译为可执行 Runnable</text>

  <circle cx="95" cy="355" r="6" fill="#1ABC9C"/>
  <text x="110" y="360" fill="#555" font-size="11" font-weight="bold">Checkpoint</text>
  <text x="115" y="377" fill="#777" font-size="9">自动保存状态快照</text>
  <text x="115" y="394" fill="#777" font-size="9">支持暂停/恢复/回溯</text>
</svg>
