<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4A90D9"/>
    </marker>
    <marker id="arrowGreen" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#5CB85C"/>
    </marker>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4A90D9;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#357ABD;stop-opacity:1"/>
    </linearGradient>
  </defs>

  <!-- 标题 -->
  <text x="400" y="28" text-anchor="middle" fill="#333" font-size="18" font-weight="bold">Dify Chatflow 工作流架构</text>

  <!-- 用户 -->
  <rect x="340" y="45" width="120" height="42" rx="21" fill="url(#blueGrad)"/>
  <text x="400" y="71" text-anchor="middle" fill="white" font-size="14" font-weight="bold">👤 用户输入</text>

  <line x1="400" y1="87" x2="400" y2="112" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 开始节点 -->
  <rect x="355" y="117" width="90" height="36" rx="18" fill="#555"/>
  <text x="400" y="139" text-anchor="middle" fill="white" font-size="12" font-weight="bold">开始</text>

  <line x1="400" y1="153" x2="400" y2="175" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- LLM 节点 -->
  <rect x="310" y="180" width="180" height="60" rx="10" fill="#9B59B6"/>
  <text x="400" y="205" text-anchor="middle" fill="white" font-size="13" font-weight="bold">🤖 LLM 节点</text>
  <text x="400" y="225" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="10">意图识别 · System Prompt</text>

  <!-- 条件分支 -->
  <line x1="310" y1="210" x2="200" y2="280" stroke="#F39C12" stroke-width="2"/>
  <line x1="400" y1="240" x2="400" y2="270" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>
  <line x1="490" y1="210" x2="600" y2="280" stroke="#27AE60" stroke-width="2"/>

  <!-- 条件判断 -->
  <rect x="330" y="275" width="140" height="30" rx="15" fill="#F39C12"/>
  <text x="400" y="294" text-anchor="middle" fill="white" font-size="11" font-weight="bold">◇ 条件分支</text>

  <!-- LLM 输出标注 -->
  <text x="295" y="268" fill="#888" font-size="9">{"intent":"..."}</text>

  <!-- HTTP 请求 -->
  <rect x="120" y="290" width="160" height="60" rx="10" fill="#2980B9"/>
  <text x="200" y="315" text-anchor="middle" fill="white" font-size="12" font-weight="bold">HTTP 请求节点</text>
  <text x="200" y="335" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="10">调用外部 API</text>

  <line x1="400" y1="305" x2="400" y2="340" stroke="#3498DB" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 代码节点 -->
  <rect x="330" y="345" width="140" height="55" rx="10" fill="#8E44AD"/>
  <text x="400" y="367" text-anchor="middle" fill="white" font-size="12" font-weight="bold">代码节点</text>
  <text x="400" y="386" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="10">Python/JS 沙箱</text>

  <line x1="200" y1="350" x2="200" y2="385" stroke="#2980B9" stroke-width="2"/>
  <line x1="200" y1="385" x2="330" y2="385" stroke="#999" stroke-width="1.5" stroke-dasharray="4,3"/>
  <line x1="200" y1="385" x2="200" y2="420" stroke="#5CB85C" stroke-width="2" marker-end="url(#arrowGreen)"/>

  <line x1="400" y1="400" x2="400" y2="425" stroke="#3498DB" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 回答节点 -->
  <rect x="325" y="430" width="150" height="42" rx="21" fill="#27AE60"/>
  <text x="400" y="456" text-anchor="middle" fill="white" font-size="13" font-weight="bold">📤 回答 (Answer)</text>

  <!-- 知识库虚线 -->
  <rect x="600" y="290" width="160" height="115" rx="10" fill="#F8F9FA" stroke="#E67E22" stroke-width="1.5" stroke-dasharray="6,3"/>
  <text x="680" y="315" text-anchor="middle" fill="#E67E22" font-size="12" font-weight="bold">📚 知识库 (RAG)</text>
  <text x="615" y="340" fill="#555" font-size="10">文档上传 → 向量检索</text>
  <text x="615" y="358" fill="#555" font-size="10">LLM 自动检索相关内容</text>
  <text x="615" y="376" fill="#555" font-size="10">增强回答准确性</text>
  <line x1="490" y1="330" x2="600" y2="330" stroke="#E67E22" stroke-width="1" stroke-dasharray="4,3"/>

  <!-- 底部说明 -->
  <rect x="55" y="440" width="230" height="48" rx="6" fill="#ECF0F1"/>
  <text x="170" y="457" text-anchor="middle" fill="#555" font-size="10">节点间数据通过 {{变量}} 语法传递</text>
  <text x="170" y="475" text-anchor="middle" fill="#555" font-size="10">如 {{LLM.text}} · {{HTTP.body}} · {{code.result}}</text>
</svg>
