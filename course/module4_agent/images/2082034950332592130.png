<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4A90D9"/>
    </marker>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4A90D9;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#357ABD;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5CB85C;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#449D44;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F0AD4E;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#EC971F;stop-opacity:1"/>
    </linearGradient>
    <linearGradient id="redGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#D9534F;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#C9302C;stop-opacity:1"/>
    </linearGradient>
  </defs>

  <!-- 用户 -->
  <rect x="340" y="20" width="120" height="50" rx="25" fill="url(#blueGrad)"/>
  <text x="400" y="50" text-anchor="middle" fill="white" font-size="16" font-weight="bold">👤 用户</text>

  <line x1="400" y1="70" x2="400" y2="105" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 自然语言 -->
  <text x="415" y="95" font-size="12" fill="#888">自然语言输入</text>

  <!-- OpenClaw -->
  <rect x="310" y="110" width="180" height="55" rx="8" fill="#2C3E50"/>
  <text x="400" y="135" text-anchor="middle" fill="white" font-size="14" font-weight="bold">OpenClaw 引擎</text>
  <text x="400" y="153" text-anchor="middle" fill="#BDC3C7" font-size="11">读取 SKILL.md → 意图匹配</text>

  <!-- 分支箭头 -->
  <line x1="310" y1="137" x2="220" y2="210" stroke="#5CB85C" stroke-width="2" marker-end="url(#arrow)"/>
  <line x1="310" y1="137" x2="580" y2="210" stroke="#F0AD4E" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 理解层标签 -->
  <rect x="330" y="180" width="140" height="24" rx="12" fill="#ECF0F1"/>
  <text x="400" y="197" text-anchor="middle" fill="#555" font-size="11">理解层</text>

  <!-- Shell 脚本 -->
  <rect x="130" y="215" width="180" height="60" rx="8" fill="url(#greenGrad)"/>
  <text x="220" y="240" text-anchor="middle" fill="white" font-size="14" font-weight="bold">Shell 封装层</text>
  <text x="220" y="258" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="11">初始化环境 · 调用 Python</text>

  <!-- Python 执行 -->
  <rect x="490" y="215" width="180" height="60" rx="8" fill="url(#orangeGrad)"/>
  <text x="580" y="240" text-anchor="middle" fill="white" font-size="14" font-weight="bold">Python 执行层</text>
  <text x="580" y="258" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="11">参数解析 · 业务逻辑</text>

  <!-- 执行层标签 -->
  <rect x="330" y="290" width="140" height="24" rx="12" fill="#ECF0F1"/>
  <text x="400" y="307" text-anchor="middle" fill="#555" font-size="11">封装层 + 执行层</text>

  <!-- 汇聚箭头 -->
  <line x1="220" y1="275" x2="400" y2="360" stroke="#5CB85C" stroke-width="1.5" stroke-dasharray="4,3"/>
  <line x1="580" y1="275" x2="400" y2="360" stroke="#F0AD4E" stroke-width="1.5" stroke-dasharray="4,3"/>

  <line x1="400" y1="335" x2="400" y2="360" stroke="#D9534F" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 输出 -->
  <rect x="340" y="365" width="120" height="50" rx="25" fill="url(#redGrad)"/>
  <text x="400" y="395" text-anchor="middle" fill="white" font-size="16" font-weight="bold">📤 结果输出</text>

  <!-- 右侧说明 -->
  <rect x="640" y="110" width="140" height="140" rx="8" fill="#F8F9FA" stroke="#DEE2E6"/>
  <text x="710" y="135" text-anchor="middle" fill="#333" font-size="12" font-weight="bold">SKILL.md</text>
  <text x="655" y="158" fill="#555" font-size="10">• name / description</text>
  <text x="655" y="176" fill="#555" font-size="10">• metadata.requires</text>
  <text x="655" y="194" fill="#555" font-size="10">• 意图→命令 映射表</text>
  <text x="655" y="212" fill="#555" font-size="10">• 自然语言规则</text>

  <line x1="490" y1="165" x2="640" y2="165" stroke="#999" stroke-width="1" stroke-dasharray="4,3"/>
</svg>
