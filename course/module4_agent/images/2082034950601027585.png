<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#4A90D9"/>
    </marker>
  </defs>

  <!-- 标题 -->
  <text x="400" y="30" text-anchor="middle" fill="#333" font-size="18" font-weight="bold">OpenClaw Skill 加载流程</text>

  <!-- 加载源 -->
  <text x="400" y="62" text-anchor="middle" fill="#888" font-size="12">(优先级从高到低)</text>

  <rect x="50" y="75" width="140" height="42" rx="8" fill="#E74C3C" opacity="0.9"/>
  <text x="120" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">1. 工作区 Skills</text>
  <text x="120" y="110" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="10">workspace/skills</text>

  <rect x="205" y="75" width="140" height="42" rx="8" fill="#E67E22" opacity="0.9"/>
  <text x="275" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">2. 项目 Skills</text>
  <text x="275" y="110" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="10">.agents/skills</text>

  <rect x="360" y="75" width="140" height="42" rx="8" fill="#F1C40F" opacity="0.85"/>
  <text x="430" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">3. 个人 Skills</text>
  <text x="430" y="110" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="10">~/.agents/skills</text>

  <rect x="515" y="75" width="140" height="42" rx="8" fill="#2ECC71" opacity="0.8"/>
  <text x="585" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">4. 托管 Skills</text>
  <text x="585" y="110" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="10">~/.openclaw/skills</text>

  <rect x="670" y="75" width="110" height="42" rx="8" fill="#3498DB" opacity="0.8"/>
  <text x="725" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">5. 内置</text>
  <text x="725" y="110" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="10">+插件 Skills</text>

  <!-- 从各加载源汇聚 -->
  <line x1="120" y1="117" x2="120" y2="145" stroke="#E74C3C" stroke-width="1.5"/>
  <line x1="275" y1="117" x2="275" y2="145" stroke="#E67E22" stroke-width="1.5"/>
  <line x1="430" y1="117" x2="430" y2="145" stroke="#F1C40F" stroke-width="1.5"/>
  <line x1="585" y1="117" x2="585" y2="145" stroke="#2ECC71" stroke-width="1.5"/>
  <line x1="725" y1="117" x2="725" y2="145" stroke="#3498DB" stroke-width="1.5"/>

  <!-- 汇聚线 -->
  <line x1="120" y1="145" x2="725" y2="145" stroke="#999" stroke-width="1"/>
  <line x1="400" y1="145" x2="400" y2="170" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 步骤1: 门控过滤 -->
  <rect x="250" y="175" width="300" height="50" rx="8" fill="#34495E"/>
  <text x="400" y="197" text-anchor="middle" fill="white" font-size="13" font-weight="bold">① 门控过滤 (Gating)</text>
  <text x="400" y="215" text-anchor="middle" fill="#BDC3C7" font-size="11">requires.bins / env / config / platforms 筛选</text>

  <line x1="400" y1="225" x2="400" y2="250" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 步骤2: Allowlist -->
  <rect x="250" y="255" width="300" height="50" rx="8" fill="#34495E"/>
  <text x="400" y="277" text-anchor="middle" fill="white" font-size="13" font-weight="bold">② Allowlist 可见性控制</text>
  <text x="400" y="295" text-anchor="middle" fill="#BDC3C7" font-size="11">按智能体限制 → 生成有效 Skills 快照</text>

  <line x1="400" y1="305" x2="400" y2="330" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 步骤3: 运行时注入 -->
  <rect x="250" y="335" width="300" height="50" rx="8" fill="#2C3E50"/>
  <text x="400" y="357" text-anchor="middle" fill="white" font-size="13" font-weight="bold">③ 运行时环境注入</text>
  <text x="400" y="375" text-anchor="middle" fill="#BDC3C7" font-size="11">env → API Key → 系统提示词(XML)</text>

  <line x1="400" y1="385" x2="400" y2="410" stroke="#4A90D9" stroke-width="2" marker-end="url(#arrow)"/>

  <!-- 步骤4: 执行 -->
  <rect x="280" y="415" width="240" height="50" rx="8" fill="#27AE60"/>
  <text x="400" y="437" text-anchor="middle" fill="white" font-size="13" font-weight="bold">④ 智能体执行任务</text>
  <text x="400" y="455" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="11">LLM 读取 Skill 指令 → 匹配命令 → 执行</text>

  <!-- 左侧说明 -->
  <rect x="20" y="175" width="200" height="295" rx="8" fill="#F8F9FA" stroke="#DEE2E6"/>
  <text x="120" y="200" text-anchor="middle" fill="#333" font-size="12" font-weight="bold">关键机制</text>
  <line x1="35" y1="210" x2="205" y2="210" stroke="#DEE2E6" stroke-width="1"/>

  <text x="35" y="233" fill="#555" font-size="10" font-weight="bold">同名覆盖</text>
  <text x="35" y="250" fill="#777" font-size="9">高优先级同名 Skill</text>
  <text x="35" y="264" fill="#777" font-size="9">覆盖低优先级</text>

  <text x="35" y="288" fill="#555" font-size="10" font-weight="bold">目录不决定名称</text>
  <text x="35" y="305" fill="#777" font-size="9">Skill 名称来自</text>
  <text x="35" y="319" fill="#777" font-size="9">frontmatter 的 name 字段</text>

  <text x="35" y="343" fill="#555" font-size="10" font-weight="bold">Token 开销</text>
  <text x="35" y="360" fill="#777" font-size="9">每个 Skill ≈ 24 tokens</text>
  <text x="35" y="374" fill="#777" font-size="9">基本开销 ≈ 195 chars</text>

  <text x="35" y="398" fill="#555" font-size="10" font-weight="bold">会话快照复用</text>
  <text x="35" y="415" fill="#777" font-size="9">会话启动时快照</text>
  <text x="35" y="429" fill="#777" font-size="9">同一会话复用</text>
  <text x="35" y="443" fill="#777" font-size="9">文件变更时刷新</text>

  <text x="35" y="463" fill="#D9534F" font-size="9" font-weight="bold">⚠ 第三方 Skill 视为不受信任代码</text>
</svg>
