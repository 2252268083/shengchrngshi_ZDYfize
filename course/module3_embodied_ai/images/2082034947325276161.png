<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" font-family="'Microsoft YaHei', 'SimHei', Arial, sans-serif">
  <defs>
    <linearGradient id="inp" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#667eea"/><stop offset="100%" style="stop-color:#764ba2"/></linearGradient>
    <linearGradient id="gate" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#f093fb"/><stop offset="100%" style="stop-color:#f5576c"/></linearGradient>
    <linearGradient id="out" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#43e97b"/><stop offset="100%" style="stop-color:#38f9d7"/></linearGradient>
    <filter id="shadow"><feDropShadow dx="1" dy="2" stdDeviation="2" flood-opacity="0.2"/></filter>
  </defs>

  <rect width="720" height="300" rx="12" fill="#f8f9fc"/>
  <text x="360" y="30" text-anchor="middle" font-size="18" font-weight="bold" fill="#2d3748">OpenClaw 智能体网关：自然语言 → 机器人控制</text>

  <!-- Input: Natural Language -->
  <rect x="30" y="55" width="140" height="80" rx="10" fill="url(#inp)" filter="url(#shadow)"/>
  <text x="100" y="90" text-anchor="middle" font-size="13" font-weight="bold" fill="#fff">💬 自然语言输入</text>
  <text x="100" y="115" text-anchor="middle" font-size="11" fill="#e8e8ff">"小车前进两米"</text>

  <!-- Arrow 1 -->
  <line x1="170" y1="95" x2="230" y2="95" stroke="#a0aec0" stroke-width="2"/>
  <polygon points="225,90 235,95 225,100" fill="#a0aec0"/>

  <!-- OpenClaw Gateway -->
  <rect x="240" y="45" width="240" height="210" rx="12" fill="url(#gate)" filter="url(#shadow)"/>
  <text x="360" y="70" text-anchor="middle" font-size="14" font-weight="bold" fill="#fff">🧠 OpenClaw 智能体网关</text>

  <rect x="255" y="85" width="210" height="32" rx="5" fill="rgba(255,255,255,0.2)"/>
  <text x="360" y="106" text-anchor="middle" font-size="11" fill="#fff">① 意图解析 → 理解用户目标</text>

  <rect x="255" y="125" width="210" height="32" rx="5" fill="rgba(255,255,255,0.2)"/>
  <text x="360" y="146" text-anchor="middle" font-size="11" fill="#fff">② 任务规划 → 分解为基本动作</text>

  <rect x="255" y="165" width="210" height="32" rx="5" fill="rgba(255,255,255,0.2)"/>
  <text x="360" y="186" text-anchor="middle" font-size="11" fill="#fff">③ 指令生成 → ROS2 Twist 消息</text>

  <rect x="255" y="205" width="210" height="32" rx="5" fill="rgba(255,255,255,0.2)"/>
  <text x="360" y="226" text-anchor="middle" font-size="11" fill="#fff">④ 动作执行 → 发布 /cmd_vel</text>

  <!-- LLM backend indicator -->
  <text x="360" y="248" text-anchor="middle" font-size="10" fill="#fefefe">LLM 后端：DeepSeek (在线) / 本地脚本 (离线)</text>

  <!-- Arrow 2 -->
  <line x1="480" y1="150" x2="540" y2="150" stroke="#a0aec0" stroke-width="2"/>
  <polygon points="535,145 545,150 535,155" fill="#a0aec0"/>

  <!-- Output: Robot -->
  <rect x="550" y="55" width="140" height="80" rx="10" fill="url(#out)" filter="url(#shadow)"/>
  <text x="620" y="90" text-anchor="middle" font-size="13" font-weight="bold" fill="#fff">🤖 机器人动作</text>
  <text x="620" y="115" text-anchor="middle" font-size="10" fill="#f0fff0">linear.x=0.5</text>

  <!-- Mode comparison -->
  <rect x="240" y="260" width="240" height="30" rx="5" fill="#fefcbf" stroke="#d69e2e" stroke-width="1"/>
  <text x="360" y="280" text-anchor="middle" font-size="11" fill="#744210">⚠ 离线考场：DEEPSEEK_API_KEY 留空，使用本地脚本</text>

  <!-- Bottom: WebSocket -->
  <rect x="500" y="260" width="190" height="30" rx="5" fill="#e8eaf6" stroke="#667eea" stroke-width="1"/>
  <text x="595" y="280" text-anchor="middle" font-size="10" fill="#667eea">🌐 面板端口：localhost:28789</text>
</svg>