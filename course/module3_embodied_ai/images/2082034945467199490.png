<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 420" font-family="'Microsoft YaHei', 'SimHei', Arial, sans-serif">
  <defs>
    <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#667eea"/><stop offset="100%" style="stop-color:#764ba2"/></linearGradient>
    <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#f093fb"/><stop offset="100%" style="stop-color:#f5576c"/></linearGradient>
    <linearGradient id="g3" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#4facfe"/><stop offset="100%" style="stop-color:#00f2fe"/></linearGradient>
    <linearGradient id="g4" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#43e97b"/><stop offset="100%" style="stop-color:#38f9d7"/></linearGradient>
    <linearGradient id="g5" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#fa709a"/><stop offset="100%" style="stop-color:#fee140"/></linearGradient>
    <filter id="shadow"><feDropShadow dx="1" dy="2" stdDeviation="2" flood-opacity="0.2"/></filter>
  </defs>

  <!-- Background -->
  <rect width="720" height="420" rx="12" fill="#f8f9fc"/>

  <!-- Title -->
  <text x="360" y="36" text-anchor="middle" font-size="20" font-weight="bold" fill="#2d3748">具身智能平台五层架构</text>

  <!-- Layer 5: LLM Agent -->
  <rect x="60" y="54" width="600" height="58" rx="8" fill="url(#g1)" filter="url(#shadow)"/>
  <text x="80" y="82" font-size="15" font-weight="bold" fill="#fff">🎯 LLM 智能体层</text>
  <text x="80" y="102" font-size="12" fill="#e0e0e0">自然语言理解 → 任务规划 → 指令生成</text>
  <text x="590" y="96" text-anchor="end" font-size="11" fill="#d0d0d0">OpenClaw / Dify</text>

  <!-- Layer 4: Dev & Orchestration -->
  <rect x="60" y="124" width="600" height="58" rx="8" fill="url(#g2)" filter="url(#shadow)"/>
  <text x="80" y="152" font-size="15" font-weight="bold" fill="#fff">💻 开发与编排层</text>
  <text x="80" y="172" font-size="12" fill="#fefefe">浏览器 IDE · 代码编辑 · 调试 · 版本管理</text>
  <text x="590" y="166" text-anchor="end" font-size="11" fill="#fefefe">code-server</text>

  <!-- Layer 3: Communication -->
  <rect x="60" y="194" width="600" height="58" rx="8" fill="url(#g3)" filter="url(#shadow)"/>
  <text x="80" y="222" font-size="15" font-weight="bold" fill="#fff">🔗 通信与网关层</text>
  <text x="80" y="242" font-size="12" fill="#fff">HTTP/WebSocket ↔ ROS2 消息双向桥接</text>
  <text x="590" y="236" text-anchor="end" font-size="11" fill="#f0f0ff">rosbridge / WebSocket</text>

  <!-- Layer 2: Robot Core -->
  <rect x="60" y="264" width="600" height="58" rx="8" fill="url(#g4)" filter="url(#shadow)"/>
  <text x="80" y="292" font-size="15" font-weight="bold" fill="#fff">🤖 机器人核心层</text>
  <text x="80" y="312" font-size="12" fill="#fff">感知（LiDAR/相机）→ 规划（导航）→ 控制（速度指令）</text>
  <text x="590" y="306" text-anchor="end" font-size="11" fill="#f0fff0">ROS2 + Gazebo</text>

  <!-- Layer 1: Container Infra -->
  <rect x="60" y="334" width="600" height="58" rx="8" fill="url(#g5)" filter="url(#shadow)"/>
  <text x="80" y="362" font-size="15" font-weight="bold" fill="#fff">⚙️ 容器化基础设施</text>
  <text x="80" y="382" font-size="12" fill="#fff">镜像管理 · 网络配置 · 数据挂载 · 多容器编排</text>
  <text x="590" y="376" text-anchor="end" font-size="11" fill="#fffff0">Docker + Compose</text>

  <!-- Vertical flow arrows between layers -->
  <line x1="48" y1="83" x2="48" y2="153" stroke="#667eea" stroke-width="2" stroke-dasharray="4,3"/>
  <line x1="48" y1="153" x2="48" y2="223" stroke="#f5576c" stroke-width="2" stroke-dasharray="4,3"/>
  <line x1="48" y1="223" x2="48" y2="293" stroke="#4facfe" stroke-width="2" stroke-dasharray="4,3"/>
  <line x1="48" y1="293" x2="48" y2="363" stroke="#43e97b" stroke-width="2" stroke-dasharray="4,3"/>

  <!-- Arrow heads -->
  <polygon points="44,150 48,158 52,150" fill="#f5576c"/>
  <polygon points="44,220 48,228 52,220" fill="#4facfe"/>
  <polygon points="44,290 48,298 52,290" fill="#43e97b"/>

  <!-- Labels on left -->
  <text x="20" y="120" font-size="10" fill="#888" transform="rotate(-90,20,120)">向上传递感知</text>
  <text x="20" y="260" font-size="10" fill="#888" transform="rotate(-90,20,260)">向下传递控制</text>
</svg>