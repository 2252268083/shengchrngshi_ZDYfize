<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 380" font-family="Arial, sans-serif">
  <defs>
    <linearGradient id="csHdr" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#007acc"/><stop offset="100%" stop-color="#005999"/></linearGradient>
    <linearGradient id="csBox" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1e1e1e"/><stop offset="100%" stop-color="#2d2d2d"/></linearGradient>
  </defs>
  <rect width="800" height="380" fill="#f8f9fa" rx="8"/>
  <text x="400" y="30" text-anchor="middle" font-size="20" font-weight="bold" fill="#333">code-server 浏览器 IDE 架构</text>
  <!-- Browser -->
  <rect x="160" y="50" width="180" height="70" rx="8" fill="#fff3e0" stroke="#ff9800" stroke-width="1.5"/>
  <text x="250" y="78" text-anchor="middle" font-size="13" font-weight="bold" fill="#e65100">🌐 学生浏览器</text>
  <text x="250" y="98" text-anchor="middle" font-size="11" fill="#555">http://localhost:18080</text>
  <text x="250" y="114" text-anchor="middle" font-size="9" fill="#999">零安装 · 打开即用</text>
  <!-- Arrow -->
  <line x1="340" y1="85" x2="400" y2="85" stroke="#666" stroke-width="2" stroke-dasharray="6,2"/>
  <text x="370" y="78" text-anchor="middle" font-size="9" fill="#666">HTTP</text>
  <text x="370" y="100" text-anchor="middle" font-size="9" fill="#666">WebSocket</text>
  <!-- code-server box -->
  <rect x="410" y="50" width="340" height="300" rx="10" fill="url(#csBox)" stroke="#007acc" stroke-width="2"/>
  <!-- VS Code header -->
  <rect x="410" y="50" width="340" height="32" rx="10" fill="url(#csHdr)"/>
  <rect x="410" y="72" width="340" height="10" fill="url(#csHdr)"/>
  <text x="580" y="72" text-anchor="middle" font-size="12" fill="#fff">VS Code Server (code-server)</text>
  <!-- Sidebar -->
  <rect x="418" y="92" width="60" height="248" rx="4" fill="#333"/>
  <text x="448" y="120" text-anchor="middle" font-size="18" fill="#fff">📁</text>
  <text x="448" y="160" text-anchor="middle" font-size="18" fill="#fff">🔍</text>
  <text x="448" y="200" text-anchor="middle" font-size="18" fill="#fff">🔧</text>
  <!-- Editor area -->
  <rect x="486" y="92" width="256" height="120" rx="4" fill="#1e1e1e" stroke="#444" stroke-width="0.5"/>
  <text x="490" y="112" font-size="10" fill="#6a9955"># 机器人控制脚本</text>
  <text x="490" y="128" font-size="10" fill="#569cd6">import</text><text x="525" y="128" font-size="10" fill="#9cdcfe"> rclpy</text>
  <text x="490" y="144" font-size="10" fill="#569cd6">from</text><text x="510" y="144" font-size="10" fill="#9cdcfe"> geometry_msgs.msg</text>
  <text x="530" y="144" font-size="10" fill="#569cd6">import</text><text x="570" y="144" font-size="10" fill="#9cdcfe"> Twist</text>
  <line x1="490" y1="152" x2="570" y2="152" stroke="#6a9955" stroke-width="1" opacity="0.3"/>
  <text x="490" y="168" font-size="10" fill="#569cd6">def</text>
  <text x="505" y="168" font-size="10" fill="#dcdcaa">go_forward</text>
  <text x="570" y="168" font-size="10" fill="#d4d4d4">(speed=</text>
  <text x="610" y="168" font-size="10" fill="#b5cea8">0.5</text>
  <text x="630" y="168" font-size="10" fill="#d4d4d4">):</text>
  <text x="505" y="184" font-size="10" fill="#d4d4d4">msg.linear.x = speed</text>
  <text x="505" y="200" font-size="10" fill="#d4d4d4">pub.publish(msg)</text>
  <!-- Terminal area -->
  <rect x="486" y="220" width="256" height="120" rx="4" fill="#1a1a1a" stroke="#444" stroke-width="0.5"/>
  <text x="490" y="240" font-size="10" fill="#4ec9b0">student@vehicle-dev:~$</text>
  <text x="590" y="240" font-size="10" fill="#d4d4d4"> ros2 topic list</text>
  <text x="490" y="256" font-size="10" fill="#9cdcfe">/bcr_bot/cmd_vel</text>
  <text x="490" y="272" font-size="10" fill="#9cdcfe">/bcr_bot/scan</text>
  <text x="490" y="288" font-size="10" fill="#9cdcfe">/bcr_bot/odom</text>
  <text x="490" y="312" font-size="10" fill="#4ec9b0">student@vehicle-dev:~$</text>
  <text x="590" y="312" font-size="10" fill="#d4d4d4"> ▊</text>
  <!-- mounted volume -->
  <text x="580" y="365" text-anchor="middle" font-size="10" fill="#89ddff">/workspace（挂载 robot-code/ → 代码持久保存）</text>
  <!-- Features box -->
  <rect x="20" y="135" width="370" height="215" rx="6" fill="#e3f2fd" stroke="#42a5f5" stroke-width="1"/>
  <text x="205" y="158" text-anchor="middle" font-size="14" font-weight="bold" fill="#1565c0">code-server 关键特性</text>
  <text x="35" y="182" font-size="12" fill="#555">✅ 零安装 — 浏览器打开即用，无需安装 VS Code</text>
  <text x="35" y="205" font-size="12" fill="#555">✅ 集成终端 — 内置终端直接在容器内执行命令</text>
  <text x="35" y="228" font-size="12" fill="#555">✅ 扩展支持 — 支持大部分 VS Code 扩展</text>
  <text x="35" y="251" font-size="12" fill="#555">✅ 容器原生 — 代码直接操作容器内文件</text>
  <text x="35" y="274" font-size="12" fill="#555">✅ 多用户 — 支持多用户同时访问不同工作区</text>
  <text x="35" y="297" font-size="12" fill="#555">✅ 离线可用 — 无需联网，本地服务</text>
  <text x="35" y="320" font-size="11" fill="#888">🎯 作用：学生通过浏览器直接操作容器内代码</text>
</svg>